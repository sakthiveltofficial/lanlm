{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LanLM",
  "version": "0.1.0",
  "identifier": "dev.lanlm.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LanLM",
        "width": 1120,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "LanLM contributors",
    "copyright": "Copyright (c) 2026 LanLM contributors. MIT License.",
    "category": "DeveloperTool",
    "shortDescription": "Run local LLMs on your PC or a cluster of PCs",
    "longDescription": "LanLM runs open GGUF language models with llama.cpp on your own computer, and can pool the memory of several PCs on your network to run bigger models. Private by design: no account and no cloud.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
